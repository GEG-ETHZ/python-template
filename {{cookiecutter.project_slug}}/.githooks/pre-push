#!/bin/bash
# Git pre-push hook to enforce branch naming conventions and protect main
# Place in .githooks/pre-push and run: git config core.hooksPath .githooks

# Allowed branch patterns
PERSISTENT_BRANCHES="^(main|develop)$"
TOPIC_BRANCH_PREFIXES="^(dev|fix|exp)/"

while read local_ref local_sha remote_ref remote_sha
do
    # Extract branch name from ref (refs/heads/branch-name -> branch-name)
    if [[ $local_ref =~ refs/heads/(.+) ]]; then
        branch="${BASH_REMATCH[1]}"
        
        # Block direct pushes to main
        if [[ $branch == "main" ]]; then
            echo "ERROR: Direct pushes to 'main' are not allowed"
            echo ""
            echo "All merges into 'main' must go through GitLab Merge Request"
            echo "Please push your work to a topic branch and create an MR"
            exit 1
        fi
        
        # Check if branch matches allowed patterns
        if [[ $branch =~ $PERSISTENT_BRANCHES ]] || [[ $branch =~ $TOPIC_BRANCH_PREFIXES ]]; then
            continue
        else
            echo "ERROR: Branch name '$branch' does not follow naming conventions"
            echo ""
            echo "Allowed branch names:"
            echo "  Persistent: main, develop"
            echo "  Topic branches: dev/<feature>, fix/<issue>, exp/<name>"
            echo ""
            echo "Examples: dev/fix-convergence, fix/issue-42, exp/thermal-model"
            exit 1
        fi
    fi
done

exit 0
