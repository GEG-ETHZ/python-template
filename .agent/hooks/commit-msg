#!/bin/sh

# Regex to check if the commit message contains the required approval string
# The string must be present anywhere in the commit message body or footer
if ! grep -q "\[HUMAN-APPROVED\]" "$1"; then
    echo "======================================================================"
    echo "⛔ COMMIT REJECTED: AI Auto-Commit Prevention Activated"
    echo "======================================================================"
    echo "This repository enforces a strict systemic rule against AI auto-commits."
    echo "To proceed, your commit message MUST contain the exact string:"
    echo "  [HUMAN-APPROVED]"
    echo ""
    echo "Please append this string to your message and try again."
    echo "======================================================================"
    exit 1
fi

# If we get here, the approval string was found
exit 0
